__pycache__/
*.pyc
tests/out/

# Converted art stays on your machine, except sets cleared to ship: the
# test set, and the free-with-credit sheets Facets uses from Taiga,
# DiegoWT, PurpleZaffre, KyleDove, Jext and Hyo (not their packs). Nintendo art (HGSS) stays
# out. -Elvie
assets/npcs/*
!assets/npcs/test_frames/
!assets/npcs/taiga/
!assets/npcs/diego/
!assets/npcs/zaffre/
!assets/npcs/community/
# GBC is a name map only: its sprites come from the player's own install. -Elvie
!assets/npcs/gbc/
!assets/npcs/gbc_2x/
# Pokémon sets: GBC ANIM (Nuuk's Hoenn; the rest from the player's own
# install) and DS (the DS-style 64x64 resource), both free with credit,
# both ship. -Elvie
assets/mons/*
!assets/mons/gbc_anim/
!assets/mons/ds/
# GBC-ISH ships its meta.json and the Game Boy party icons; its
# pictures are read from the player's Crystal or made from their Emerald. -Elvie
!assets/mons/gbcish/
# GB EMERALD ships only its meta.json: it's made from the player's Emerald. -Elvie
!assets/mons/gb_emerald/
# Trainer sets: GAME BOY ships only its meta.json. GBC-ISH ships its
# gb.json name map and the Gen 2-style pictures by jphyper, sirwhibbles,
# eli76 and SkidMarc25 (used with credit); the rest come from the
# player's own install. -Elvie
assets/trainers/*
!assets/trainers/gbcish/
!assets/trainers/gameboy/
# DS: trainer sprites by KyleDove, Mr. Gela, Jext and figyberries, used with credit. -Elvie
!assets/trainers/ds/
# Window sets: Tito Seich's ship (used with credit). Sets made with
# tools/ips_extract.py stay on your machine, and LibertyTwins' until it's
# confirmed the frames are their own drawings. -Elvie
assets/windows/*
!assets/windows/tito/
# tools/ips_extract.py's output, and pret's symbol file it fetches -Elvie
extracted/
tools/pokefirered.sym
tools/textbox_map.bin
