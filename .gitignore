__pycache__/
*.pyc
tests/out/

# Converted art stays on your machine, except sets cleared to ship: the
# test set, and the free-with-credit sheets Facets uses from Taiga,
# DiegoWT, PurpleZaffre, KyleDove, Jext and Hyo (not their packs). Nintendo art (HGSS) stays
# out. -Elvie
assets/npcs/*
!assets/npcs/test_frames/
!assets/npcs/taiga/
!assets/npcs/diego/
!assets/npcs/zaffre/
!assets/npcs/community/
# GBC is a name map only: its sprites come from the player's own install. -Elvie
!assets/npcs/gbc/
!assets/npcs/gbc_2x/
# Pokémon sets: GBC reads the player's own install plus E-SY's Hoenn
# sprites; DS is the DS-style 64x64 resource. Both free with credit, both
# ship. -Elvie
assets/mons/*
!assets/mons/gbc/
!assets/mons/ds/
